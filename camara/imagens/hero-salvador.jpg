<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="700" viewBox="0 0 1600 700">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0b2545"/>
      <stop offset="60%" stop-color="#133c55"/>
      <stop offset="100%" stop-color="#1e5f8a"/>
    </linearGradient>
    <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1e5f8a"/>
      <stop offset="100%" stop-color="#0b2545"/>
    </linearGradient>
  </defs>
  <!-- Céu -->
  <rect width="1600" height="700" fill="url(#sky)"/>
  <!-- Sol -->
  <circle cx="1200" cy="150" r="80" fill="#f3d06a" opacity="0.8"/>
  <circle cx="1200" cy="150" r="110" fill="#f3d06a" opacity="0.15"/>
  <!-- Nuvens -->
  <ellipse cx="300" cy="120" rx="120" ry="40" fill="#ffffff" opacity="0.12"/>
  <ellipse cx="420" cy="100" rx="90" ry="35" fill="#ffffff" opacity="0.1"/>
  <ellipse cx="900" cy="80" rx="150" ry="45" fill="#ffffff" opacity="0.09"/>
  <!-- Prédios do centro histórico -->
  <rect x="0" y="350" width="120" height="350" fill="#0b2545" opacity="0.9"/>
  <rect x="10" y="280" width="100" height="80" fill="#133c55"/>
  <rect x="110" y="320" width="90" height="380" fill="#133c55"/>
  <rect x="190" y="300" width="140" height="400" fill="#0b2545"/>
  <rect x="320" y="360" width="80" height="340" fill="#133c55" opacity="0.85"/>
  <rect x="390" y="290" width="110" height="410" fill="#0b2545"/>
  <rect x="490" y="340" width="130" height="360" fill="#133c55"/>
  <rect x="610" y="310" width="95" height="390" fill="#0b2545" opacity="0.9"/>
  <rect x="695" y="350" width="120" height="350" fill="#133c55"/>
  <rect x="810" y="320" width="85" height="380" fill="#0b2545"/>
  <rect x="885" y="340" width="100" height="360" fill="#133c55" opacity="0.85"/>
  <rect x="975" y="300" width="130" height="400" fill="#0b2545"/>
  <rect x="1095" y="350" width="110" height="350" fill="#133c55"/>
  <rect x="1195" y="330" width="95" height="370" fill="#0b2545" opacity="0.9"/>
  <rect x="1280" y="310" width="130" height="390" fill="#133c55"/>
  <rect x="1400" y="350" width="200" height="350" fill="#0b2545"/>
  <!-- Farol da Barra (ícone) -->
  <rect x="750" y="200" width="30" height="160" fill="#ffffff" opacity="0.7"/>
  <polygon points="735,200 795,200 765,160" fill="#d4af37" opacity="0.8"/>
  <!-- Água / Baía -->
  <rect x="0" y="520" width="1600" height="180" fill="url(#water)" opacity="0.9"/>
  <!-- Reflexo na água -->
  <ellipse cx="800" cy="560" rx="600" ry="30" fill="#1e5f8a" opacity="0.4"/>
  <!-- Brilho dourado no horizonte -->
  <rect x="0" y="510" width="1600" height="8" fill="#d4af37" opacity="0.3"/>
  <!-- Texto overlay leve -->
  <text x="800" y="680" text-anchor="middle" font-family="Georgia, serif" font-size="18" fill="#f3d06a" opacity="0.5">Salvador, Bahia — Brasil</text>
</svg>
